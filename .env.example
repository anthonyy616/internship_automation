OPENAI_API_KEY=sk-your-key-here

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Connection string from your Neon project dashboard
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ── Redis (arq task queue) ──────────────────────────────────────────────────
# Local: redis://127.0.0.1:6379  (IMPORTANT: use 127.0.0.1, not "localhost" —
#   on Windows, localhost may resolve to ::1 first and hang the connection
#   past arq's 1s connect timeout, causing "Timeout connecting to server")
# Cloud: rediss://default:password@host:port
# Docker: redis://redis:6379 (the compose service name)
REDIS_URL=redis://127.0.0.1:6379

# ── SMTP (Email Sending) ────────────────────────────────────────────────────
# Gmail: smtp.gmail.com / 587  (requires App Password)
# Yahoo: smtp.mail.yahoo.com / 587  (requires App Password)
# Custom domain: your SMTP server details
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Telegram Bot (Category-A question escalation) ────────────────────────────
# Create a bot via @BotFather on Telegram, then get the chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=your-chat-id

# ── Managed Browser (Hyperbrowser) ──────────────────────────────────────────
# Optional — replaces local Chromium with managed anti-bot cloud sessions
# (stealth + rotating proxies handled server-side). No SDK install needed:
# the bot talks to the REST API directly via httpx. Get a key at
# https://hyperbrowser.ai. Leave blank to use local Chromium.
HYPERBROWSER_API_KEY=
# Session lifetime in minutes (max 720). Sessions auto-stop on their own.
HYPERBROWSER_TIMEOUT_MINUTES=30
# Set to true ONLY if your Hyperbrowser plan supports proxies (the free plan
# rejects useProxy with HTTP 402; the bot then retries without it).
HYPERBROWSER_USE_PROXY=false

# ── Proxies ──────────────────────────────────────────────────────────────────
# Optional — comma-separated proxy URLs (any residential provider). Formats:
#   http://user:pass@host:port   https://user:pass@host:port   socks5://host:port
# Proxies rotate round-robin per browser session; a proxy that fails
# repeatedly is cooled down and skipped. Ignored while Hyperbrowser is used.
# PROXY_URLS=http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080
# Consecutive failures before a proxy is cooled down (default 3)
# APPLY_PROXY_FAIL_THRESHOLD=3
# How long a cooled-down proxy is skipped, in seconds (default 600)
# APPLY_PROXY_COOLDOWN_SECONDS=600

# ── Cloudflare R2 (Screenshot Storage) ──────────────────────────────────────
# Optional — screenshots stored locally in data/screenshots/ by default.
# Enable when you want cloud storage (S3-compatible, zero egress fees).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=internship-bot-screenshots

# ── Admin Panel ──────────────────────────────────────────────────────────────
# Password for the admin dashboard (set once, stored as bcrypt hash)
# Leave blank to disable auth (local dev only — never do this in production)
ADMIN_PASSWORD=
# TOTP secret for 2FA (generated on first admin setup, base32 encoded)
# Leave blank to skip 2FA setup (local dev only)
ADMIN_TOTP_SECRET=

# ── Deployment ───────────────────────────────────────────────────────────────
# Set to 'production' in production, 'development' locally
APP_ENV=development
# Host and port for the FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000
